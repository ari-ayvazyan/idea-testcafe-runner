<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>at.itdo.idea-testcafe-runner</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>TestCafe Support</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://itdo.at" email="support@itdo.at">IT-DO</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p><strong>Comprehensive TestCafe support for IntelliJ IDEA with intelligent test execution and exclusive test handling.</strong></p>

        <h3>Key Features:</h3>
        <ul>
            <li><strong>Smart Detection:</strong> Automatically finds TestCafe fixtures and tests in .spec.js, .spec.ts files</li>
            <li><strong>One-Click Execution:</strong> Run tests with convenient play buttons next to test declarations</li>
            <li><strong>Exclusive Test Support:</strong> Intelligent handling of test.only() and fixture.only() with visual indicators</li>
            <li><strong>Smart Editor Notifications:</strong> Info bars alert when exclusive tests are present</li>
            <li><strong>Flexible Configuration:</strong> Customize TestCafe commands and browser settings</li>
            <li><strong>Integrated Results:</strong> View test output directly in IntelliJ's run tool window</li>
            <li><strong>Context Menu Support:</strong> Right-click to run tests from anywhere</li>
            <li><strong>Multi-Format Support:</strong> Works with JavaScript, TypeScript, and ES6 TestCafe tests</li>
        </ul>

        <h3>Perfect for:</h3>
        <ul>
            <li>Front-end developers using TestCafe for E2E testing</li>
            <li>QA teams running automated browser tests</li>
            <li>Teams wanting seamless IDE integration for test execution</li>
            <li>Developers who need proper exclusive test (.only) behavior</li>
        </ul>

        <p>Supports TestCafe's full feature set including live mode, parallel execution, exclusive tests, and multiple browser testing.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.javascript</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Line marker provider for run buttons -->
        <codeInsight.lineMarkerProvider
            language="JavaScript"
            implementationClass="at.itdo.tcrunner.LineMarkerProvider" />

        <!-- Settings UI -->
        <projectConfigurable
            parentId="tools"
            instance="at.itdo.tcrunner.SettingsConfigurable"
            id="at.itdo.tcrunner.settings"
            displayName="TestCafe Support" />

        <!-- Run Configuration -->
        <configurationType
            implementation="at.itdo.tcrunner.run.ConfigurationType" />

        <!-- Run Configuration Producer -->
        <runConfigurationProducer
            implementation="at.itdo.tcrunner.run.RunConfigurationProducer" />

        <!-- Editor Notification Provider for test.only/fixture.only detection -->
        <editorNotificationProvider
            implementation="at.itdo.tcrunner.notifications.TestOnlyNotificationProvider" />

    </extensions>

    <!-- Actions -->
    <actions>
        <group id="TestCafeActions" text="TestCafe" description="TestCafe test runner actions">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolBar" anchor="after" relative-to-action="RunnerActions"/>

            <action id="TestCafe.RunAllProject"
                    class="at.itdo.tcrunner.actions.RunAllTestsInProjectAction"
                    text="Run All TestCafe Tests in Project"
                    description="Run all TestCafe tests in the current project">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F10"/>
            </action>

            <action id="TestCafe.RunAllDirectory"
                    class="at.itdo.tcrunner.actions.RunAllTestsInDirectoryAction"
                    text="Run All TestCafe Tests in Directory"
                    description="Run all TestCafe tests in the selected directory">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt F10"/>
            </action>

            <action id="TestCafe.Settings"
                    class="at.itdo.tcrunner.actions.SettingsAction"
                    text="TestCafe Support Settings..."
                    description="Configure TestCafe Support settings">
            </action>
        </group>
    </actions>
</idea-plugin>
